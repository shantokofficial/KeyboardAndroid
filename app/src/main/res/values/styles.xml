<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MlBanglaKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:background">#222222</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="MlBanglaActionKey" parent="MlBanglaKey">
        <item name="android:background">#333333</item>
        <item name="android:textColor">#E5E5E5</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="MlBanglaSpaceKey" parent="MlBanglaKey">
        <item name="android:background">#2A2A2A</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EmojiKeyStyle" parent="MlBanglaKey">
        <item name="android:background">#1E1E1E</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>
